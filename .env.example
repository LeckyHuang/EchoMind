# ==================== 服务配置 ====================
DEBUG=true
HOST=0.0.0.0
PORT=8088

# JWT 密钥（必填，启动前必须设置为随机强密钥）
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_strong_random_secret_key_here
JWT_EXPIRE_HOURS=72
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100
FILE_EXPIRE_HOURS=168
CORS_ORIGINS=*

# ==================== ASR 配置 ====================
# ASR 提供商: qwen(阿里云), doubao(豆包), tencent(腾讯云), baidu(百度)
ASR_PROVIDER=qwen

# 阿里云 ASR (通义)
QWEN_API_KEY=your_aliyun_api_token
QWEN_APP_KEY=your_aliyun_app_key

# 豆包 ASR
DOUBAO_APP_ID=your_doubao_app_id
DOUBAO_TOKEN=your_doubao_token

# 腾讯云 ASR
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_APP_ID=your_tencent_app_id

# 百度 ASR
BAIDU_APP_ID=your_baidu_app_id
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# ==================== LLM 配置 ====================
# LLM 提供商: minimax, kimi, qwen, doubao, zhipu
LLM_PROVIDER=minimax

# MiniMax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# Kimi (Moonshot)
KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 通义千问 (Qwen)
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 豆包 (Doubao)
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-32k

# 智谱 GLM
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4
